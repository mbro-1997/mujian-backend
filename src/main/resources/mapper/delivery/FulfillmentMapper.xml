<select id="selectOrderOutboundDOByOrder" resultMap="OrderOutboundDO" useCache="false" flushCache="true">SELECT id,rental_order_id,outbound_transport_leg_id,factory_id,outbound_status,outbound_service_mode,transport_requirement_snapshot,outbound_photo_count,operator_user_id,outbound_at,dispatch_at,remark,version,created_at,updated_at FROM order_outbound_record WHERE rental_order_id=#{orderId}</select>
<insert id="insertOutbound">INSERT INTO order_outbound_record(id,rental_order_id,outbound_transport_leg_id,factory_id,outbound_status,outbound_service_mode,transport_requirement_snapshot,outbound_photo_count,operator_user_id,outbound_at,dispatch_at,remark,version,created_at,updated_at) VALUES(#{row.id},#{row.rentalOrderId},#{row.outboundTransportLegId},#{row.factoryId},#{row.outboundStatus},#{row.outboundServiceMode},#{row.transportRequirementSnapshot},#{row.outboundPhotoCount},#{row.operatorUserId},#{row.outboundAt},#{row.dispatchAt},#{row.remark},#{row.version},#{row.createdAt},#{row.updatedAt})</insert>
