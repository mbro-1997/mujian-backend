<arg column="rental_order_id" javaType="java.lang.String"/>
<arg column="outbound_transport_leg_id" javaType="java.lang.String"/>
<arg column="factory_id" javaType="java.lang.String"/>
<arg column="outbound_status" javaType="java.lang.String"/>
<arg column="outbound_service_mode" javaType="java.lang.String"/>
<arg column="transport_requirement_snapshot" javaType="java.lang.String"/>
<arg column="outbound_photo_count" javaType="java.lang.Integer"/>
<arg column="operator_user_id" javaType="java.lang.String"/>
<arg column="outbound_at" javaType="java.time.LocalDateTime"/>
<arg column="dispatch_at" javaType="java.time.LocalDateTime"/>
