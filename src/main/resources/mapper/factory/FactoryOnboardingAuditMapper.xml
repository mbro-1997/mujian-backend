<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mujian.backend.factory.mapper.FactoryOnboardingAuditMapper">
<select id="hasFactoryOnboardingByInvitation" resultType="boolean" useCache="false" flushCache="true">SELECT COUNT(*) &gt; 0 FROM factory_onboarding_audit WHERE invite_code_id=#{invite}</select>
  
<insert id="insertFactoryOnboarding">INSERT INTO factory_onboarding_audit (factory_name,unified_social_credit_code,factory_avatar_url,business_license_url,factory_photo_urls,contact_name,contact_phone,factory_address,main_business,worker_count,specialty_category_ids_json,specialty_category_names_snapshot_json,case_materials_json,remark,id,application_no,submit_request_id,request_hash,accepted_rule_document_ids_json,previous_application_id,applicant_user_id,invite_code_id,audit_status,version,submitted_at,created_at,updated_at) VALUES (#{factoryOnboardingAuditDO.factoryName},#{factoryOnboardingAuditDO.unifiedSocialCreditCode},#{factoryOnboardingAuditDO.factoryAvatarUrl},#{factoryOnboardingAuditDO.businessLicenseUrl},#{factoryOnboardingAuditDO.factoryPhotoUrls},#{factoryOnboardingAuditDO.contactName},#{factoryOnboardingAuditDO.contactPhone},#{factoryOnboardingAuditDO.factoryAddress},#{factoryOnboardingAuditDO.mainBusiness},#{factoryOnboardingAuditDO.workerCount},#{factoryOnboardingAuditDO.specialtyCategoryIdsJson},#{factoryOnboardingAuditDO.specialtyCategoryNamesSnapshotJson},#{factoryOnboardingAuditDO.caseMaterialsJson},#{factoryOnboardingAuditDO.remark},#{factoryOnboardingAuditDO.id},#{factoryOnboardingAuditDO.applicationNo},#{factoryOnboardingAuditDO.submitRequestId},#{factoryOnboardingAuditDO.requestHash},#{factoryOnboardingAuditDO.acceptedRuleDocumentIdsJson},#{factoryOnboardingAuditDO.previousApplicationId},#{factoryOnboardingAuditDO.applicantUserId},#{factoryOnboardingAuditDO.inviteCodeId},#{factoryOnboardingAuditDO.auditStatus},#{factoryOnboardingAuditDO.version},#{factoryOnboardingAuditDO.submittedAt},#{factoryOnboardingAuditDO.createdAt},#{factoryOnboardingAuditDO.updatedAt})</insert>
  
<update id="reviewFactoryOnboarding">UPDATE factory_onboarding_audit SET audit_status=#{factoryOnboardingAuditDO.auditStatus},reviewed_by_admin_user_id=#{factoryOnboardingAuditDO.reviewedByAdminUserId},reviewed_at=#{factoryOnboardingAuditDO.reviewedAt},reject_reason=#{factoryOnboardingAuditDO.rejectReason},version=#{factoryOnboardingAuditDO.version},updated_at=#{factoryOnboardingAuditDO.updatedAt},created_factory_id=#{factoryOnboardingAuditDO.createdFactoryId},audit_remark=#{factoryOnboardingAuditDO.auditRemark} WHERE id=#{factoryOnboardingAuditDO.id}</update>
  
</mapper>
