<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
  <groupId>com.mujian</groupId><artifactId>mujian-backend</artifactId><version>0.1.0</version>
  <name>mujian-backend</name><description>D1 最小框架</description>
  <properties>
    <java.version>17</java.version>
    <mj.build.directory>${project.basedir}/target/d1</mj.build.directory>
    <mybatis.version>4.1.0</mybatis.version>
    <!-- 只为 Maven 本地运行设置默认环境；打包后的应用不会默认进入 local。 -->
    <app.profiles>local</app.profiles>
  </properties>
  <dependencies>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
    <dependency><groupId>com.qcloud</groupId><artifactId>cos_api</artifactId><version>5.6.227</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-session-data-redis</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>${mybatis.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <!-- 保留交接前已有的忽略产物；本轮验证只使用独立输出目录。 -->
    <directory>${mj.build.directory}</directory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/../mujian-frontend/share</directory><targetPath>static/share</targetPath><includes><include>scheme.html</include><include>scheme.js</include><include>scheme.css</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <profiles>${app.profiles}</profiles>
          <!-- 仅 Maven 启动的应用进程收到此标志；测试、打包和独立 JAR 不继承。 -->
          <systemPropertyVariables><mj.mini-debug.maven>true</mj.mini-debug.maven></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
